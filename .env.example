# Copie para .env.local e preencha com a configuração do app Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Site público (servidor): JSON inteiro da conta de serviço, numa linha. Na Vercel, como variável secreta.
# Sem ela, o site abre mas mostra "o cardápio não carregou" e manda pro WhatsApp.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Chave do site do reCAPTCHA Enterprise (App Check), criada no mesmo projeto do Firebase. Sem ela, a rota de pedido recusa tudo em produção.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Só para os scripts de seed e de usuário em produção (nunca vai para a Vercel).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
