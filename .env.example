# Copie para .env.local e preencha com a configuração do app Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Só para os scripts de seed e de usuário em produção (nunca vai para a Vercel).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
